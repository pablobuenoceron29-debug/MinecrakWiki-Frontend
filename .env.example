# Copia este archivo a .env.local para desarrollo local:  cp .env.example .env.local
#
# URL base del backend NestJS (SIN barra final y CON protocolo http:// o https://).
# Local:   http://localhost:3000   (si el frontend también usa 3000, arráncalo con: npx next dev -p 3001)
# Vercel:  https://tu-backend-publico.com   (se define en Project > Settings > Environment Variables
#          y requiere REDESPLEGAR, porque NEXT_PUBLIC_* se incrusta durante el build)
NEXT_PUBLIC_API_URL=http://localhost:3000
